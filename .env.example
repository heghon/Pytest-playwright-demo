SAUCEDEMO_USERNAME=saucedemo_username_here -> standard_user (given because it's public)
SAUCEDEMO_PASSWORD=saucedemo_password_here --> secret_sauce (given because it's public)

# Optional. Turns the @JIRA-xxx tags into links in the report's Jira column.
# Leave it out and the keys still show, just as plain text.
# JIRA_BASE_URL=https://your-site.atlassian.net
